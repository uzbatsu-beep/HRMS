FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

RUN groupadd --gid 10001 twm && useradd --uid 10001 --gid 10001 --no-create-home twm
COPY pyproject.toml README.md ./
COPY alembic.ini ./
COPY migrations ./migrations
COPY app ./app
RUN pip install --no-cache-dir . && mkdir -p /tmp && chown twm:twm /tmp

USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers", "--no-access-log"]
