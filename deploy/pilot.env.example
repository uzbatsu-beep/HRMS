# Copy to a private file outside git and use:
# docker compose --env-file /secure/pilot.env -f deploy/compose.pilot.yml config
# These paths must be ABSOLUTE and point to existing, independently managed files.
POSTGRES_DB=twm
POSTGRES_USER=twm
TWM_PUBLIC_ORIGIN=https://twm.example.invalid
TWM_HTTPS_BIND_ADDRESS=127.0.0.1
TWM_HTTPS_PORT=8443
TWM_PG_PASSWORD_FILE=/secure/twm/db_password
TWM_THROTTLE_SECRET_FILE=/secure/twm/throttle_hmac
TWM_TLS_CERT_FILE=/secure/twm/fullchain.pem
TWM_TLS_KEY_FILE=/secure/twm/privkey.pem
